rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // 🛡️ PAGALBINĖS SAUGUMO IR TAPATYBĖS TIKRINIMO FUNKCIJOS
    // ============================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isNotAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Savininko el. pašto adresai
    function isOwnerEmail() {
      return isNotAnonymous() && (
        request.auth.token.email.lower() == 'dominikphotofficial.lt@gmail.com' ||
        request.auth.token.email.lower() == 'dominik.suskevic@gmail.com' ||
        request.auth.token.email.lower() == 'info@dominikphotofficial.lt'
      );
    }

    // Komandos nario / administratoriaus patikra
    function isTeamAdmin() {
      return isNotAnonymous() && (
        exists(/databases/$(database)/documents/admin_team/$(request.auth.uid)) ||
        (request.auth.token.admin == true)
      );
    }

    function isAdmin() {
      return isOwnerEmail() || isTeamAdmin();
    }

    // Numatytas draudimas visiems neaprašytiems keliams
    match /{document=**} {
      allow read, write: if false;
    }

    // ============================================================================
    // 📋 DUOMENŲ BAZĖS KOLEKCIJŲ TAISYKLĖS
    // ============================================================================

    // 1. TFP Užklausos:
    // Klientai gali sukurti užklausas viešai. Administratoriai skaito, redaguoja ir trina.
    match /tfp_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // 2. Mokamų Paslaugų Užklausos:
    // Klientai pildo užsakymus svetainėje. Administratoriai valdo.
    match /service_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // 3. Kontaktų Žinutės (Forma iš contacts.html):
    // Lankytojai siunčia žinutes. Administratoriai skaito ir apdoroja.
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // 4. Klientų Atsiliepimai:
    // Klientai teikia atsiliepimus, patvirtinti atsiliepimai rodomi viešai, administratoriai moderuoja.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // 5. Nustatymai ir atsiliepimų matomumo valdymas:
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /admin_settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /reviews_visibility/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 6. El. Pašto Eilė (Firebase Mail Extension / Pranešimų siuntimas):
    // Naudojama siųsti patvirtinimo laiškus ir 2FA kodus.
    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // 7. Komandos Teisės ir Vartotojų Rolės (RBAC):
    // Leidžia patikrinti komandos nario autorizaciją prisijungus arba registruojantis.
    match /admin_team/{memberId} {
      allow read: if true;
      allow create: if isOwnerEmail() || isSignedIn() || (request.auth != null && request.auth.uid == memberId);
      allow update, delete: if isOwnerEmail() || isSignedIn();
    }

    // 8. VMI Pajamų ir Išlaidų Žurnalas, Kvitų Apskaita:
    // Prieinama autorizuotiems administratoriams / buhalteriui.
    match /vmi_expenses/{expenseId} {
      allow read, write: if isSignedIn();
    }

    // 9. Veiksmų Žurnalas (Audit Logs):
    // Fiksuoja administratoriaus veiksmus sistemoje.
    match /audit_logs/{logId} {
      allow create: if true;
      allow read: if isSignedIn();
      allow update, delete: if isOwnerEmail();
    }
  }
}
