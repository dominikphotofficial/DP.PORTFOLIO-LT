rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // 🛡️ PAGALBINĖS SAUGUMO IR TAPATYBĖS TIKRINIMO FUNKCIJOS
    // ============================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isNotAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Sistemos savininko el. pašto adresai ir custom claims
    function isOwnerEmail() {
      return isNotAnonymous() && (
        request.auth.token.email.lower() == 'dominikphotofficial.lt@gmail.com' ||
        request.auth.token.email.lower() == 'dominik.suskevic@gmail.com' ||
        request.auth.token.email.lower() == 'info@dominikphotofficial.lt' ||
        request.auth.token.admin == true
      );
    }

    // Komandos nario patikra pagal vartotojo UID kolekcijoje admin_team
    function isTeamMember() {
      return isNotAnonymous() && (
        isOwnerEmail() ||
        (exists(/databases/$(database)/documents/admin_team/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admin_team/$(request.auth.uid)).data.active != false)
      );
    }

    // Teisių patikra pagal nario priskirtas privilegijas
    function hasPermission(perm) {
      return isOwnerEmail() || (
        isTeamMember() &&
        exists(/databases/$(database)/documents/admin_team/$(request.auth.uid)) &&
        (
          ('all' in get(/databases/$(database)/documents/admin_team/$(request.auth.uid)).data.permissions) ||
          (perm in get(/databases/$(database)/documents/admin_team/$(request.auth.uid)).data.permissions)
        )
      );
    }

    // Numatytas draudimas visiems neaprašytiems keliams
    match /{document=**} {
      allow read, write: if false;
    }

    // ============================================================================
    // 📋 DUOMENŲ BAZĖS KOLEKCIJŲ TAISYKLĖS
    // ============================================================================

    // 1. TFP Užklausos:
    // Lankytojai kuria užklausas svetainėje. Administratoriai skaito, tvarko ir trina.
    match /tfp_requests/{requestId} {
      allow create: if true;
      allow read, update: if isSignedIn();
      allow delete: if isOwnerEmail() || hasPermission('Trinimas') || isSignedIn();
    }

    // 2. Mokamų Paslaugų Užklausos:
    // Lankytojai pildo užsakymus svetainėje. Administratoriai valdo.
    match /service_requests/{requestId} {
      allow create: if true;
      allow read, update: if isSignedIn();
      allow delete: if isOwnerEmail() || hasPermission('Trinimas') || isSignedIn();
    }

    // 3. Kontaktų Žinutės (Forma iš contacts.html):
    // Lankytojai siunčia žinutes. Administratoriai skaito ir apdoroja.
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update: if isSignedIn();
      allow delete: if isOwnerEmail() || hasPermission('Trinimas') || isSignedIn();
    }

    // 4. Klientų Atsiliepimai:
    // Klientai teikia atsiliepimus, patvirtinti atsiliepimai rodomi viešai.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update: if isSignedIn();
      allow delete: if isOwnerEmail() || hasPermission('Trinimas') || isSignedIn();
    }

    // 5. Nustatymai ir atsiliepimų matomumo valdymas:
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /admin_settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /reviews_visibility/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 6. El. Pašto Eilė (Firebase Mail Extension / Pranešimų siuntimas):
    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // 7. Komandos Teisės ir Vartotojų Rolės (RBAC):
    // Skaitymas prieinamas autorizacijos patikrai. Kūrimas/keitimas – savininkui arba pačiam nariui (susiejimui).
    match /admin_team/{memberId} {
      allow read: if true;
      allow create, update: if isOwnerEmail() || (isSignedIn() && request.auth.uid == memberId) || isSignedIn();
      allow delete: if isOwnerEmail();
    }

    // 8. VMI Pajamų ir Išlaidų Žurnalas, Kvitų Apskaita:
    match /vmi_expenses/{expenseId} {
      allow read, write: if isSignedIn();
    }

    // 9. Veiksmų Žurnalas (Audit Logs):
    match /audit_logs/{logId} {
      allow create: if true;
      allow read: if isSignedIn();
      allow update, delete: if isOwnerEmail();
    }
  }
}
