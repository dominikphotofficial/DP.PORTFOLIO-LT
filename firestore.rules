rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // TFP Requests: Public can create; Signed-in admin can read, update, delete
    match /tfp_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // Service Requests: Public can create; Signed-in admin can read, update, delete
    match /service_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // Reviews: Public can read; Signed-in users can create, update, delete
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings: Public can read; Anyone/Admin can write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Mail Queue: Public and Admin can create mail records
    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }
  }
}
