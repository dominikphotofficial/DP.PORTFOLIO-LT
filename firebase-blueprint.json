{
  "entities": {
    "TFPRequest": {
      "title": "TFP Request",
      "description": "Collaboration photoshoot request from potential model or creator",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "instagram": { "type": "string", "maxLength": 150 },
        "tiktok": { "type": "string", "maxLength": 150 },
        "social": { "type": "string", "maxLength": 150 },
        "socialProfile": { "type": "string", "maxLength": 200 },
        "date_time": { "type": "string", "maxLength": 80 },
        "location": { "type": "string", "maxLength": 150 },
        "idea": { "type": "string", "maxLength": 1000 },
        "photos": { "type": "array" },
        "reference_photos": { "type": "array" },
        "extra_info": { "type": "string", "maxLength": 1500 },
        "contractAgreed": { "type": "boolean" },
        "adminNotes": { "type": "string", "maxLength": 2000 },
        "language": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["New", "Pending", "Confirmed", "Rescheduled", "Completed", "Cancelled"] },
        "galleryUrl": { "type": "string", "maxLength": 500 },
        "contract_pdf_url": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "date_time", "location", "idea"]
    },
    "ServiceRequest": {
      "title": "Service Request",
      "description": "Client booking for paid photography or videography services",
      "type": "object",
      "properties": {
        "clientName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "clientCode": { "type": "string", "maxLength": 40 },
        "clientAddress": { "type": "string", "maxLength": 200 },
        "socialProfile": { "type": "string", "maxLength": 200 },
        "serviceId": { "type": "string", "maxLength": 60 },
        "serviceName": { "type": "string", "maxLength": 120 },
        "originalPrice": { "type": "number" },
        "finalPrice": { "type": "number" },
        "depositPercentage": { "type": "number" },
        "depositAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "receiptNeeded": { "type": "string", "maxLength": 10 },
        "preferredDate": { "type": "string", "maxLength": 50 },
        "preferredTime": { "type": "string", "maxLength": 50 },
        "location": { "type": "string", "maxLength": 150 },
        "additionalInformation": { "type": "string", "maxLength": 1500 },
        "adminNotes": { "type": "string", "maxLength": 2000 },
        "reference_photos": { "type": "array" },
        "language": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Deposit Paid", "In Progress", "Fully Paid", "Completed", "Cancelled"] },
        "galleryUrl": { "type": "string", "maxLength": 500 },
        "receiptUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientName", "email", "serviceId", "serviceName", "preferredDate"]
    },
    "ContactMessage": {
      "title": "Contact Message",
      "description": "Public contact form inquiry from website visitors",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "subject": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 3000 },
        "status": { "type": "string", "enum": ["New", "Answered", "Replied", "Archived"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message"]
    },
    "Review": {
      "title": "Review",
      "description": "Client and model testimonials and reviews for portfolio",
      "type": "object",
      "properties": {
        "clientName": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["service", "tfp"] },
        "sessionTag": { "type": "string", "maxLength": 150 },
        "rating": { "type": "number" },
        "date": { "type": "string", "maxLength": 30 },
        "reviewLink": { "type": "string", "maxLength": 500 },
        "comment": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["pending", "published", "hidden"] },
        "visible": { "type": "boolean" },
        "orderId": { "type": "string", "maxLength": 128 },
        "token": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientName", "comment"]
    },
    "ReviewToken": {
      "title": "Review Invitation Token",
      "description": "One-time invitation token linking an emailed review request to an order or TFP session without storing PII",
      "type": "object",
      "properties": {
        "token": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["service", "tfp"] },
        "sessionTag": { "type": "string", "maxLength": 150 },
        "sessionDate": { "type": "string", "maxLength": 50 },
        "orderId": { "type": "string", "maxLength": 128 },
        "orderCollection": { "type": "string", "enum": ["service_requests", "tfp_requests", "manual"] },
        "language": { "type": "string", "maxLength": 10 },
        "used": { "type": "boolean" },
        "reviewId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "usedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["token", "clientName", "type", "used"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Website global configuration and toggle settings",
      "type": "object",
      "properties": {
        "visible": { "type": "boolean" },
        "showSection": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "AdminSetting": {
      "title": "Admin Setting",
      "description": "Private administrative settings including Google Sheets link and private billing details",
      "type": "object",
      "properties": {
        "spreadsheetId": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 200 },
        "url": { "type": "string", "maxLength": 500 },
        "lastSync": { "type": "string", "maxLength": 80 },
        "lastSyncBy": { "type": "string", "maxLength": 120 },
        "createdBy": { "type": "string", "maxLength": 120 },
        "recipient": { "type": "string", "maxLength": 150 },
        "iban": { "type": "string", "maxLength": 60 },
        "bank": { "type": "string", "maxLength": 100 },
        "paypal": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "ReviewsVisibility": {
      "title": "Reviews Visibility",
      "description": "Legacy visibility flag document for testimonials section",
      "type": "object",
      "properties": {
        "showReviews": { "type": "boolean" },
        "visible": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Mail": {
      "title": "Mail",
      "description": "Queued email notification triggered upon booking and updates",
      "type": "object",
      "properties": {
        "to": { "type": "string", "format": "email", "maxLength": 120 },
        "from": { "type": "string", "maxLength": 150 },
        "replyTo": { "type": "string", "maxLength": 150 },
        "message": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["to", "message"]
    },
    "AdminTeamMember": {
      "title": "Admin Team Member",
      "description": "Authorized admin and team members with assigned roles and privileges",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "uid": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["superadmin", "manager", "photographer", "accountant"] },
        "permissions": { "type": "array" },
        "customPermissions": { "type": "boolean" },
        "active": { "type": "boolean" },
        "status": { "type": "string", "enum": ["invited", "active", "suspended"] },
        "lastInviteSentAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "role"]
    },
    "VmiExpense": {
      "title": "VMI Expense",
      "description": "Business expense for Lithuanian individual activity tax reporting (EVRK 74.20)",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "amount": { "type": "number" },
        "category": { "type": "string", "maxLength": 60 },
        "date": { "type": "string", "maxLength": 30 },
        "invoiceNumber": { "type": "string", "maxLength": 60 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "amount", "date"]
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "Registry of administrative actions, edits, status updates and system activity",
      "type": "object",
      "properties": {
        "userEmail": { "type": "string", "maxLength": 120 },
        "userName": { "type": "string", "maxLength": 100 },
        "actionType": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 500 },
        "details": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["actionType", "description"]
    }
  },
  "firestore": {
    "/tfp_requests/{requestId}": {
      "schema": "TFPRequest",
      "description": "Submissions from TFP registration form"
    },
    "/service_requests/{requestId}": {
      "schema": "ServiceRequest",
      "description": "Submissions from paid services booking form"
    },
    "/contact_messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Submissions from public contact form"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer reviews and testimonials displayed on portfolio"
    },
    "/review_tokens/{tokenId}": {
      "schema": "ReviewToken",
      "description": "One-time invitation tokens linking emailed review requests to completed sessions"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "System and website presentation preferences"
    },
    "/admin_settings/{settingId}": {
      "schema": "AdminSetting",
      "description": "Private administrative settings including Google Sheets link and private billing details"
    },
    "/reviews_visibility/{docId}": {
      "schema": "ReviewsVisibility",
      "description": "Legacy reviews visibility flag collection"
    },
    "/mail/{mailId}": {
      "schema": "Mail",
      "description": "Automated email queue"
    },
    "/admin_team/{memberId}": {
      "schema": "AdminTeamMember",
      "description": "Team members with administrative access and role-based permissions"
    },
    "/vmi_expenses/{expenseId}": {
      "schema": "VmiExpense",
      "description": "Documented tax expenses for individual activity accounting"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Chronological audit trail of user actions and administrative changes"
    }
  }
}
